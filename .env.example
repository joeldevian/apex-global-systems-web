# ── Supabase (Postgres gestionado) ──────────────────────────────────────────
# El agente NO crea el proyecto de Supabase ni ejecuta nada contra él.
# El cliente debe:
#   1. Crear su proyecto en https://supabase.com
#   2. Ejecutar en orden los scripts de /sql en el SQL Editor de Supabase
#   3. Completar estas dos variables
# El proyecto compila y corre sin ellas: el endpoint de contacto responderá
# 503 ("base de datos no configurada") hasta que se completen.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── API (NestJS) ─────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ── Web (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
